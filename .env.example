# Supabase Configuration
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Push Notifications Security
PUSH_API_KEY=<generate-strong-random-key>
ALLOWED_ORIGIN=https://yourdomain.com

# VAPID Keys (for web push notifications)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Telegram reminder bot
# 1. Create a bot with @BotFather, copy the token and the bot username (no @).
# 2. Generate a webhook secret: openssl rand -hex 32
# 3. Optional: a group chat id for the one summary ping per session.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LEAGUE_CHAT_ID=

# Cron authentication (POST /api/cron/reminders)
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Service-role key for server-only writes (bypasses RLS — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used in Telegram links and the ICS feed
APP_URL=https://downforce.lovable.app
